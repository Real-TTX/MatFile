@page
@model MatFile.Web.Pages.Admin.Roles.EditModel
@{
    ViewData["Title"] = (Model.IsNew ? L["Role.New.Title"] : L["Role.Edit.Title"]).Value;
}

<div class="mf-page mf-page-form">
    <h1>@(Model.IsNew ? L["Role.New.Title"] : L["Role.Edit.Title"])</h1>
    <partial name="/Pages/Admin/_AdminTabs.cshtml" />

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mf-alert mf-alert-error" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.IsSystemRole)
    {
        <div class="mf-alert mf-alert-warning" role="status">@L["Role.SystemHint"]</div>
    }

    <form method="post" class="mf-card">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="mf-form-grid">
            <mf-field label="@L["Role.Name"]" for="Input.Name">
                <input asp-for="Input.Name" required readonly="@Model.IsSystemRole" />
            </mf-field>

            <mf-field label="@L["Role.Description"]" for="Input.Description">
                <input asp-for="Input.Description" />
            </mf-field>

            <mf-field label="@L["Role.Permissions"]" wide="true">
                <div class="mf-checklist mf-checklist-grid">
                    @foreach (var permission in Model.AllPermissions)
                    {
                        <label class="mf-check">
                            <input type="checkbox" name="Input.Permissions" value="@permission"
                                   checked="@Model.Input.Permissions.Contains(permission.ToString())"
                                   disabled="@Model.IsSystemRole" />
                            <span>@Model.PermissionLabel(permission)</span>
                        </label>
                    }
                </div>
            </mf-field>
        </div>

        <mf-actions>
            <button type="submit" class="mf-btn mf-btn-primary">
                <mf-icon name="save" />@L["Common.Save"]
            </button>
            <a class="mf-btn" href="@(string.IsNullOrEmpty(Model.ReturnUrl) ? Url.Page("./Index") : Model.ReturnUrl)">
                <mf-icon name="arrow-left" />@L["Common.Back"]
            </a>

            @if (!Model.IsNew && !Model.IsSystemRole)
            {
                <mf-actions-gap />
                <button type="submit" class="mf-btn mf-btn-danger" asp-page-handler="Delete"
                        formnovalidate data-confirm="@L["Common.ConfirmDelete"]">
                    <mf-icon name="trash" />@L["Common.Delete"]
                </button>
            }
        </mf-actions>
    </form>
</div>
