@using System.Globalization
@inject AppInfo AppInfo
@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var isFullBleed = (ViewData["Layout"] as string) == "full";

    // Erscheinungsbild aus dem Cookie, damit die Seite ohne Aufblitzen richtig startet.
    var theme = Context.Request.Cookies["matfile.theme"];
    if (theme is not ("light" or "dark"))
    {
        theme = "auto";
    }
}
<!DOCTYPE html>
<html lang="@currentCulture" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] &middot; MatFile</title>
    @* Moderne Browser nehmen das SVG, ältere und Windows-Verknüpfungen die ICO. *@
    <link rel="icon" href="~/icons/matfile.svg" type="image/svg+xml" />
    <link rel="icon" href="~/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />
    <meta name="theme-color" content="#3b82f6" />
    <link rel="stylesheet" href="~/css/matfile.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="mf-app @(isFullBleed ? "mf-app-full" : string.Empty)">
        <header class="mf-topbar">
            <a class="mf-brand" href="/">
                <img src="~/icons/matfile.svg" alt="" />
                <span>MatFile</span>
            </a>
            <span class="mf-spacer"></span>

            @* Im Explorer sitzen Sprache, Erscheinungsbild und Konto unten links in der Seitenleiste. *@
            @if (!isFullBleed)
            {
                <partial name="_LanguageDialog" />
                <partial name="_ThemeToggle" />

                if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="mf-user" title="@User.Identity.Name">@User.GetDisplayName()</span>
                    <a class="mf-btn mf-btn-quiet" asp-page="/Account/ChangePassword">@L["Layout.ChangePassword"]</a>
                    <form method="post" asp-page="/Logout" class="mf-inline-form">
                        <button type="submit" class="mf-btn mf-btn-quiet">@L["Layout.Logout"]</button>
                    </form>
                }
            }

            @* Im Explorer steht die Version unten links in der Seitenleiste. *@
            @if (!isFullBleed)
            {
                <span class="mf-badge" title="@AppInfo.Channel">@AppInfo.Version</span>
            }
        </header>

        <main class="mf-content @(isFullBleed ? "mf-content-full" : string.Empty)">
            @RenderBody()
        </main>

        @if (!isFullBleed)
        {
            <footer class="mf-footer">
                MatFile @AppInfo.Version &middot; @AppInfo.Channel
            </footer>
        }
    </div>

    <script src="~/js/matfile.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
