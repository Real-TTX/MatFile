@page
@model MatFile.Web.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = (Model.IsNew ? L["User.New.Title"] : L["User.Edit.Title"]).Value;
}

<div class="mf-page mf-page-form">
    <h1>@(Model.IsNew ? L["User.New.Title"] : L["User.Edit.Title"])</h1>
    <partial name="/Pages/Admin/_AdminTabs.cshtml" />

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mf-alert mf-alert-error" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post" class="mf-card">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="mf-form-grid">
            <mf-field label="@L["User.Username"]" for="Input.Username">
                <input asp-for="Input.Username" autocomplete="off" required />
            </mf-field>

            <mf-field label="@L["User.DisplayName"]" for="Input.DisplayName">
                <input asp-for="Input.DisplayName" autocomplete="off" />
            </mf-field>

            <mf-field label="@L["User.Email"]" for="Input.Email">
                <input asp-for="Input.Email" type="email" autocomplete="off" />
            </mf-field>

            <mf-field label="@L["User.Password"]" for="Input.NewPassword"
                      hint="@(Model.IsNew ? null : L["User.PasswordKeep"].Value)">
                <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" />
            </mf-field>

            <mf-field wide="true">
                <label class="mf-check">
                    <input asp-for="Input.IsActive" type="checkbox" />
                    <span>@L["User.IsActive"]</span>
                </label>
                <label class="mf-check">
                    <input asp-for="Input.MustChangePassword" type="checkbox" />
                    <span>@L["User.MustChangePassword"]</span>
                </label>
            </mf-field>

            <mf-field label="@L["User.Roles"]" wide="true">
                <div class="mf-checklist">
                    @foreach (var role in Model.AllRoles)
                    {
                        <label class="mf-check">
                            <input type="checkbox" name="Input.RoleIds" value="@role.Id"
                                   checked="@Model.Input.RoleIds.Contains(role.Id)" />
                            <span>@role.Name</span>
                            @if (!string.IsNullOrEmpty(role.Description))
                            {
                                <span class="mf-muted mf-small">@role.Description</span>
                            }
                        </label>
                    }
                </div>
            </mf-field>
        </div>

        <mf-actions>
            <button type="submit" class="mf-btn mf-btn-primary">
                <mf-icon name="save" />@L["Common.Save"]
            </button>
            <a class="mf-btn" href="@(string.IsNullOrEmpty(Model.ReturnUrl) ? Url.Page("./Index") : Model.ReturnUrl)">
                <mf-icon name="arrow-left" />@L["Common.Back"]
            </a>

            @if (!Model.IsNew)
            {
                <mf-actions-gap />
                <button type="submit" class="mf-btn mf-btn-danger" asp-page-handler="Delete"
                        formnovalidate data-confirm="@L["Common.ConfirmDelete"]">
                    <mf-icon name="trash" />@L["Common.Delete"]
                </button>
            }
        </mf-actions>
    </form>
</div>
