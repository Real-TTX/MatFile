@page
@model IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Explorer";
    ViewData["Layout"] = "full";

    var displayName = User.GetDisplayName();
    var initials = new string(displayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => part[0])
        .ToArray()).ToUpperInvariant();
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}

@section Head {
    <link rel="stylesheet" href="~/css/explorer.css" asp-append-version="true" />
}

<div class="mfx" id="mfx">
    <aside class="mfx-sidebar" id="mfx-sidebar" aria-label="@L["Explorer.Sidebar"]">
        <div class="mfx-side-scroll">
        <section class="mfx-side-group" id="mfx-roots-group">
            <h2>@L["Explorer.Roots"]</h2>
            <ul class="mfx-side-list" id="mfx-roots"></ul>
        </section>

        <section class="mfx-side-group" id="mfx-connections-group" hidden>
            <h2>@L["Explorer.Connections"]</h2>
            <ul class="mfx-side-list" id="mfx-connections"></ul>
        </section>

        <section class="mfx-side-group">
            <h2>@L["Explorer.Bookmarks"]</h2>
            <ul class="mfx-side-list" id="mfx-bookmarks"></ul>
        </section>
        </div>

        @* Konto, Erscheinungsbild, Sprache und Abmelden - unten links. *@
        <footer class="mfx-side-foot">
            <a class="mfx-account" asp-page="/Account/ChangePassword" title="@L["Layout.ChangePassword"]">
                <span class="mfx-avatar">@initials</span>
                <span class="mfx-account-text">
                    <span class="mfx-account-name">@displayName</span>
                    <span class="mfx-account-login">@User.Identity!.Name</span>
                </span>
            </a>

            <div class="mfx-side-tools">
                @if (User.HasPermission(Permission.ManageUsers) || User.HasPermission(Permission.ManageRoles)
                     || User.HasPermission(Permission.ManageRoots))
                {
                    <a class="mfx-btn" asp-page="/Admin/Index" title="@L["Admin.Title"]"
                       aria-label="@L["Admin.Title"]">
                        <mf-icon name="settings" />
                    </a>
                }

                <partial name="_ThemeToggle" />
                <partial name="_LanguageDialog" />

                <span class="mf-spacer"></span>

                <form method="post" asp-page="/Logout" class="mf-inline-form">
                    <button type="submit" class="mfx-btn" title="@L["Layout.Logout"]"
                            aria-label="@L["Layout.Logout"]">
                        <mf-icon name="log-out" />
                    </button>
                </form>
            </div>
        </footer>
    </aside>

    <div class="mfx-backdrop" id="mfx-backdrop" hidden></div>

    <div class="mfx-main">
        @* Menüleiste über den Tabs, wie im Datei-Explorer. *@
        <nav class="mfx-menubar" id="mfx-menubar" aria-label="@L["Explorer.MenuBar"]">
            <button type="button" class="mfx-menubar-item" data-menu="file">@L["Explorer.MenuFile"]</button>
            <button type="button" class="mfx-menubar-item" data-menu="edit">@L["Explorer.MenuEdit"]</button>
            <button type="button" class="mfx-menubar-item" data-menu="view">@L["Explorer.MenuView"]</button>
            @if (User.HasPermission(Permission.ManageRoots))
            {
                <button type="button" class="mfx-menubar-item" data-menu="locations">@L["Admin.Roots"]</button>
            }
            <button type="button" class="mfx-menubar-item" data-menu="settings">@L["Explorer.MenuSettings"]</button>
        </nav>

        <div class="mfx-tabbar" id="mfx-tabs" role="tablist"></div>

        <div class="mfx-toolbar">
            <button type="button" class="mfx-btn mfx-only-mobile" id="mfx-sidebar-toggle"
                    title="@L["Explorer.Sidebar"]" aria-label="@L["Explorer.Sidebar"]">
                <mf-icon name="folder" />
            </button>

            <button type="button" class="mfx-btn" id="mfx-back" title="@L["Explorer.Back"]" aria-label="@L["Explorer.Back"]">
                <mf-icon name="chevron-left" />
            </button>
            <button type="button" class="mfx-btn" id="mfx-forward" title="@L["Explorer.Forward"]" aria-label="@L["Explorer.Forward"]">
                <mf-icon name="chevron-right" />
            </button>
            <button type="button" class="mfx-btn" id="mfx-up" title="@L["Explorer.Up"]" aria-label="@L["Explorer.Up"]">
                <mf-icon name="arrow-left" class="mfx-rotate" />
            </button>
            <button type="button" class="mfx-btn" id="mfx-refresh" title="@L["Explorer.Refresh"]" aria-label="@L["Explorer.Refresh"]">
                <mf-icon name="refresh" />
            </button>
            <button type="button" class="mfx-btn" id="mfx-upload" title="@L["Explorer.Upload"]" aria-label="@L["Explorer.Upload"]">
                <mf-icon name="upload" />
            </button>
            <button type="button" class="mfx-btn" id="mfx-newfolder" title="@L["Explorer.NewFolder"]" aria-label="@L["Explorer.NewFolder"]">
                <mf-icon name="folder-plus" />
            </button>

            <nav class="mfx-breadcrumb" id="mfx-breadcrumb" aria-label="@L["Explorer.Path"]"></nav>

            <div class="mfx-search">
                <mf-icon name="search" />
                <input type="search" id="mfx-search" placeholder="@L["Explorer.Search"]"
                       aria-label="@L["Explorer.Search"]" />
            </div>

            <button type="button" class="mfx-btn" id="mfx-hidden" title="@L["Explorer.ShowHidden"]"
                    aria-pressed="false" aria-label="@L["Explorer.ShowHidden"]">
                <mf-icon name="alert" />
            </button>
            <button type="button" class="mfx-btn" id="mfx-view" title="@L["Explorer.ViewGrid"]"
                    aria-label="@L["Explorer.ViewGrid"]">
                <mf-icon name="folder" />
            </button>
            <button type="button" class="mfx-btn" id="mfx-details-toggle" title="@L["Explorer.Details"]"
                    aria-pressed="false" aria-label="@L["Explorer.Details"]">
                <mf-icon name="info" />
            </button>
            @if (User.HasPermission(Permission.ManageRoots))
            {
                <button type="button" class="mfx-btn" id="mfx-more" title="@L["Explorer.More"]"
                        aria-label="@L["Explorer.More"]">
                    <mf-icon name="settings" />
                </button>
            }
        </div>

        <div class="mfx-body">
            <div class="mfx-listing" id="mfx-listing" tabindex="0" role="grid" aria-label="Explorer"></div>
            <aside class="mfx-details" id="mfx-details" hidden aria-label="@L["Explorer.Details"]"></aside>
        </div>

        <div class="mfx-status" id="mfx-status"></div>
    </div>
</div>

<ul class="mfx-menu" id="mfx-menu" role="menu" hidden></ul>

@section Scripts {
    <script>
        window.matfileText = @Html.Raw(Model.TextBundleJson);
        window.matfileCan = { manageRoots: @(User.HasPermission(Permission.ManageRoots) ? "true" : "false") };
    </script>
    <script type="module" src="~/js/explorer/explorer.js" asp-append-version="true"></script>
}
