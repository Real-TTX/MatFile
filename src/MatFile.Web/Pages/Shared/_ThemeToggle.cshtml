@* Umschalter für das Erscheinungsbild: System, hell, dunkel. *@
<button type="button" class="mf-theme-toggle" data-theme-toggle
        title="@L["Theme"]" aria-label="@L["Theme"]">
    <span class="mf-theme-icon" data-theme-icon="auto"><mf-icon name="monitor" /></span>
    <span class="mf-theme-icon" data-theme-icon="light"><mf-icon name="sun" /></span>
    <span class="mf-theme-icon" data-theme-icon="dark"><mf-icon name="moon" /></span>
</button>
