@page
@model ErrorModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="mf-container mf-container-narrow">
    <div class="mf-card">
        <h1>@Model.Title</h1>
        <p class="mf-muted">@Model.Message</p>

        @if (Model.ShowRequestId)
        {
            <dl class="mf-facts">
                <dt>@L["Error.RequestId"]</dt>
                <dd class="mf-mono">@Model.RequestId</dd>
            </dl>
        }

        <div class="mf-actions">
            <a class="mf-btn mf-btn-primary" href="/">@L["Error.Home"]</a>
        </div>
    </div>
</div>
