<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MatFile.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*" />
    <!-- Die ganze App im Speicher (Plattformvertrag, Anmeldung über MatIdentity). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- Neuer als das, was Mvc.Testing mitbringt (10.0.11 hat bekannte Schwachstellen). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MatFile.Web\MatFile.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Das Icon-Sprite von MatUi (Kopie von MatDesign src/MatUi/wwwroot/img/matui-icons.svg; MatFile hat noch kein MatUi):
         die Icons, die eine MatApiDefinition nennen darf - Mattiverse zeichnet sie damit. -->
    <None Update="Fixtures\matui-icons.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
