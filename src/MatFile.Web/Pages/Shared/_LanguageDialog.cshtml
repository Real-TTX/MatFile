@using System.Globalization
@{
    var languageCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var languageReturnUrl = Context.Request.Path + Context.Request.QueryString;
}

@* Knopf mit Kürzel; die Auswahl selbst passiert im Dialog. *@
<button type="button" class="mf-lang-button" data-dialog-open="mf-language-dialog"
        title="@L["Common.Language"]" aria-label="@L["Common.Language"]">
    <mf-icon name="globe" />
    <span>@MatFileCultures.LabelOf(languageCulture)</span>
</button>

<dialog class="mfx-dialog mf-language-dialog" id="mf-language-dialog">
    <header class="mfx-dialog-head">
        <mf-icon name="globe" size="20" />
        <h2>@L["Common.Language"]</h2>
        <span class="mf-spacer"></span>
        <button type="button" class="mfx-btn mfx-dialog-close" data-dialog-close
                title="@L["Common.Cancel"]" aria-label="@L["Common.Cancel"]">
            <mf-icon name="x" size="14" />
        </button>
    </header>

    @* Die Liste bringt ihr eigenes Polster mit, deshalb hier keins. *@
    <div class="mfx-dialog-body">
        <form method="post" asp-page="/SetLanguage" class="mf-language-list">
            <input type="hidden" name="returnUrl" value="@languageReturnUrl" />

            @foreach (var (code, label, name) in MatFileCultures.Supported)
            {
                var isActive = string.Equals(code, languageCulture, StringComparison.OrdinalIgnoreCase);

                <button type="submit" name="culture" value="@code"
                        class="mf-language-option @(isActive ? "is-active" : string.Empty)"
                        aria-current="@(isActive ? "true" : "false")">
                    <span class="mf-language-code">@label</span>
                    <span class="mf-language-name">@name</span>
                    @if (isActive)
                    {
                        <mf-icon name="check" />
                    }
                </button>
            }
        </form>
    </div>

    <div class="mf-actions mfx-dialog-foot">
        <button type="button" class="mf-btn" data-dialog-close>@L["Common.Cancel"]</button>
    </div>
</dialog>
