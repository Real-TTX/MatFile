@page
@model IndexModel
@{
    ViewData["Title"] = "Explorer";
    ViewData["Layout"] = "full";
}

@section Head {
    <link rel="stylesheet" href="~/css/explorer.css" asp-append-version="true" />
}

<div class="mfx" id="mfx">
    <aside class="mfx-sidebar" id="mfx-sidebar" aria-label="@L["Explorer.Sidebar"]">
        <section class="mfx-side-group">
            <h2>@L["Explorer.Roots"]</h2>
            <ul class="mfx-side-list" id="mfx-roots"></ul>
        </section>

        <section class="mfx-side-group">
            <h2>@L["Explorer.Bookmarks"]</h2>
            <ul class="mfx-side-list" id="mfx-bookmarks"></ul>
        </section>
    </aside>

    <div class="mfx-backdrop" id="mfx-backdrop" hidden></div>

    <div class="mfx-main">
        <div class="mfx-tabbar" id="mfx-tabs" role="tablist"></div>

        <div class="mfx-toolbar">
            <button type="button" class="mfx-btn mfx-only-mobile" id="mfx-sidebar-toggle"
                    title="@L["Explorer.Sidebar"]" aria-label="@L["Explorer.Sidebar"]">
                <mf-icon name="folder" />
            </button>

            <button type="button" class="mfx-btn" id="mfx-back" title="@L["Explorer.Back"]" aria-label="@L["Explorer.Back"]">
                <mf-icon name="chevron-left" />
            </button>
            <button type="button" class="mfx-btn" id="mfx-forward" title="@L["Explorer.Forward"]" aria-label="@L["Explorer.Forward"]">
                <mf-icon name="chevron-right" />
            </button>
            <button type="button" class="mfx-btn" id="mfx-up" title="@L["Explorer.Up"]" aria-label="@L["Explorer.Up"]">
                <mf-icon name="arrow-left" class="mfx-rotate" />
            </button>
            <button type="button" class="mfx-btn" id="mfx-refresh" title="@L["Explorer.Refresh"]" aria-label="@L["Explorer.Refresh"]">
                <mf-icon name="refresh" />
            </button>
            <button type="button" class="mfx-btn" id="mfx-upload" title="@L["Explorer.Upload"]" aria-label="@L["Explorer.Upload"]">
                <mf-icon name="upload" />
            </button>
            <button type="button" class="mfx-btn" id="mfx-newfolder" title="@L["Explorer.NewFolder"]" aria-label="@L["Explorer.NewFolder"]">
                <mf-icon name="folder-plus" />
            </button>

            <nav class="mfx-breadcrumb" id="mfx-breadcrumb" aria-label="@L["Explorer.Path"]"></nav>

            <div class="mfx-search">
                <mf-icon name="search" />
                <input type="search" id="mfx-search" placeholder="@L["Explorer.Search"]"
                       aria-label="@L["Explorer.Search"]" />
            </div>

            <button type="button" class="mfx-btn" id="mfx-hidden" title="@L["Explorer.ShowHidden"]"
                    aria-pressed="false" aria-label="@L["Explorer.ShowHidden"]">
                <mf-icon name="alert" />
            </button>
            <button type="button" class="mfx-btn" id="mfx-view" title="@L["Explorer.ViewGrid"]"
                    aria-label="@L["Explorer.ViewGrid"]">
                <mf-icon name="folder" />
            </button>
        </div>

        <div class="mfx-listing" id="mfx-listing" tabindex="0" role="grid" aria-label="Explorer"></div>

        <div class="mfx-status" id="mfx-status"></div>
    </div>
</div>

<ul class="mfx-menu" id="mfx-menu" role="menu" hidden></ul>

@section Scripts {
    <script>window.matfileText = @Html.Raw(Model.TextBundleJson);</script>
    <script type="module" src="~/js/explorer/explorer.js" asp-append-version="true"></script>
}
