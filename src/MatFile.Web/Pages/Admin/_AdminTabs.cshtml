@using MatFile.Web.Controls
@using MatFile.Web.Data
@{
    var current = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;

    var tabs = new List<TabItem>();

    if (User.HasPermission(Permission.ManageUsers))
    {
        tabs.Add(new TabItem(
            L["Admin.Users"],
            Url.Page("/Admin/Users/Index")!,
            current.StartsWith("/Admin/Users", StringComparison.OrdinalIgnoreCase),
            "users"));
    }

    if (User.HasPermission(Permission.ManageRoles))
    {
        tabs.Add(new TabItem(
            L["Admin.Roles"],
            Url.Page("/Admin/Roles/Index")!,
            current.StartsWith("/Admin/Roles", StringComparison.OrdinalIgnoreCase),
            "shield"));
    }

    if (User.HasPermission(Permission.ManageRoots))
    {
        tabs.Add(new TabItem(
            L["Admin.Roots"],
            Url.Page("/Admin/Roots/Index")!,
            current.StartsWith("/Admin/Roots", StringComparison.OrdinalIgnoreCase),
            "hard-drive"));
    }
}

<mf-tabbar id="admin" items="tabs" />
