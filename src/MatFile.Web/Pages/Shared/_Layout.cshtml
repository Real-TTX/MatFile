@using System.Globalization
@inject AppInfo AppInfo
@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] &middot; MatFile</title>
    <link rel="icon" href="~/icons/matfile.svg" type="image/svg+xml" />
    <link rel="manifest" href="~/site.webmanifest" />
    <meta name="theme-color" content="#3b82f6" />
    <link rel="stylesheet" href="~/css/matfile.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="mf-app">
        <header class="mf-topbar">
            <a class="mf-brand" href="/">
                <img src="~/icons/matfile.svg" alt="" />
                <span>MatFile</span>
            </a>
            <span class="mf-spacer"></span>

            <form method="post" asp-page="/SetLanguage" class="mf-lang" title="@L["Common.Language"]">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                @foreach (var (code, label) in MatFileCultures.Supported)
                {
                    <button type="submit" name="culture" value="@code"
                            class="mf-lang-btn @(code == currentCulture ? "is-active" : "")"
                            aria-current="@(code == currentCulture ? "true" : "false")">@label</button>
                }
            </form>

            @if (User.Identity?.IsAuthenticated == true)
            {
                if (User.HasPermission(Permission.ManageUsers) || User.HasPermission(Permission.ManageRoles))
                {
                    <a class="mf-btn mf-btn-quiet" asp-page="/Admin/Index">
                        <mf-icon name="settings" />@L["Admin.Title"]
                    </a>
                }

                <span class="mf-user" title="@User.Identity.Name">@User.GetDisplayName()</span>
                <a class="mf-btn mf-btn-quiet" asp-page="/Account/ChangePassword">@L["Layout.ChangePassword"]</a>
                <form method="post" asp-page="/Logout" class="mf-inline-form">
                    <button type="submit" class="mf-btn mf-btn-quiet">@L["Layout.Logout"]</button>
                </form>
            }

            <span class="mf-badge" title="@AppInfo.Channel">@AppInfo.Version</span>
        </header>

        <main class="mf-content">
            @RenderBody()
        </main>

        <footer class="mf-footer">
            MatFile @AppInfo.Version &middot; @AppInfo.Channel
        </footer>
    </div>

    <script src="~/js/matfile.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
