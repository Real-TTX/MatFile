@page
@model MatFile.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = L["ChangePassword.Title"].Value;
}

<div class="mf-container mf-container-narrow">
    <div class="mf-card">
        <h1>@L["ChangePassword.Title"]</h1>

        @if (Model.MustChange)
        {
            <div class="mf-alert mf-alert-warning" role="alert">@L["ChangePassword.Forced"]</div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mf-alert mf-alert-error" role="alert">@Model.ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="mf-alert mf-alert-success" role="alert">@Model.SuccessMessage</div>
        }

        <form method="post" class="mf-form">
            <div class="mf-field">
                <label asp-for="Input.CurrentPassword">@L["ChangePassword.Current"]</label>
                <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" required />
                <span asp-validation-for="Input.CurrentPassword" class="mf-field-error"></span>
            </div>

            <div class="mf-field">
                <label asp-for="Input.NewPassword">@L["ChangePassword.New"]</label>
                <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" required />
                <span class="mf-field-hint">@L["ChangePassword.Hint", Model.MinPasswordLength]</span>
                <span asp-validation-for="Input.NewPassword" class="mf-field-error"></span>
            </div>

            <div class="mf-field">
                <label asp-for="Input.ConfirmPassword">@L["ChangePassword.Confirm"]</label>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
                <span asp-validation-for="Input.ConfirmPassword" class="mf-field-error"></span>
            </div>

            <div class="mf-actions">
                <button type="submit" class="mf-btn mf-btn-primary">@L["Common.Save"]</button>
                @if (!Model.MustChange)
                {
                    <a class="mf-btn" href="/">@L["Common.Back"]</a>
                }
            </div>
        </form>
    </div>
</div>
