@page
@using MatFile.Web.Storage
@model MatFile.Web.Pages.Admin.Roots.EditModel
@{
    ViewData["Title"] = (Model.IsNew ? L["Root.New.Title"] : L["Root.Edit.Title"]).Value;
}

<div class="mf-page mf-page-form">
    <h1>@(Model.IsNew ? L["Root.New.Title"] : L["Root.Edit.Title"])</h1>
    <partial name="/Pages/Admin/_AdminTabs.cshtml" />

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mf-alert mf-alert-error" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="mf-alert mf-alert-success" role="status">@Model.StatusMessage</div>
    }

    <form method="post" class="mf-card">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="mf-form-grid">
            <mf-field label="@L["Root.Name"]" for="Input.Name">
                <input asp-for="Input.Name" required />
            </mf-field>

            <mf-field label="@L["Root.Type"]" for="Input.StorageType">
                <select asp-for="Input.StorageType" data-visibility-source>
                    @foreach (var type in Model.SupportedTypes)
                    {
                        <option value="@type" disabled="@(!StorageProviderFactory.IsSupported(type))"
                                selected="@(Model.Input.StorageType == type)">
                            @type @(StorageProviderFactory.IsSupported(type) ? string.Empty : "(" + L["Root.NotYetSupported"].Value + ")")
                        </option>
                    }
                </select>
            </mf-field>

            <mf-field label="@L["Root.Path"]" for="Input.BasePath" hint="@L["Root.PathHint"].Value" wide="true">
                <input asp-for="Input.BasePath" class="mf-mono" placeholder="/storage/tank" />
            </mf-field>

            <mf-field label="@L["Root.Icon"]" for="Input.DisplayIcon">
                <select asp-for="Input.DisplayIcon">
                    @foreach (var icon in MatFile.Web.Pages.Admin.Roots.EditModel.IconChoices)
                    {
                        <option value="@icon" selected="@(Model.Input.DisplayIcon == icon)">@icon</option>
                    }
                </select>
            </mf-field>

            <mf-field label="@L["Root.SortOrder"]" for="Input.SortOrder">
                <input asp-for="Input.SortOrder" type="number" min="0" step="1" />
            </mf-field>

            <mf-field wide="true">
                <label class="mf-check">
                    <input asp-for="Input.IsEnabled" type="checkbox" />
                    <span>@L["Root.IsEnabled"]</span>
                </label>
            </mf-field>
        </div>

        <div data-visible-for="Sftp,Ftp,Smb,WebDav">
            <h2>@L["Root.Connection"]</h2>
            <p class="mf-muted mf-small">@L["Root.ConnectionHint"]</p>

            <div class="mf-form-grid">
                <mf-field label="@L["Root.Host"]" for="Input.Host" data-visible-for="Sftp,Ftp,Smb">
                    <input asp-for="Input.Host" placeholder="192.168.1.100" />
                </mf-field>

                <mf-field label="@L["Root.Port"]" for="Input.Port" hint="@L["Root.PortHint"].Value"
                          data-visible-for="Sftp,Ftp,Smb">
                    <input asp-for="Input.Port" type="number" min="0" max="65535" />
                </mf-field>

                <mf-field label="@L["Root.Url"]" for="Input.Url" wide="true" data-visible-for="WebDav"
                          hint="@L["Root.UrlHint"].Value">
                    <input asp-for="Input.Url" class="mf-mono" placeholder="https://nas.example.com/remote.php/dav/files/user" />
                </mf-field>

                <mf-field label="@L["Root.Share"]" for="Input.Share" data-visible-for="Smb">
                    <input asp-for="Input.Share" placeholder="data" />
                </mf-field>

                <mf-field label="@L["Root.Username"]" for="Input.Username">
                    <input asp-for="Input.Username" autocomplete="off" />
                </mf-field>

                <mf-field label="@L["Root.Password"]" for="Input.Password"
                          hint="@(Model.HasStoredPassword ? L["Root.PasswordStored"].Value : null)">
                    <input asp-for="Input.Password" type="password" autocomplete="new-password" />
                </mf-field>

                <mf-field wide="true">
                    @if (Model.HasStoredPassword)
                    {
                        <label class="mf-check">
                            <input asp-for="Input.ClearPassword" type="checkbox" />
                            <span>@L["Root.ClearPassword"]</span>
                        </label>
                    }
                    <label class="mf-check" data-visible-for="Ftp,WebDav">
                        <input asp-for="Input.UseTls" type="checkbox" />
                        <span>@L["Root.UseTls"]</span>
                    </label>
                    <label class="mf-check" data-visible-for="Ftp">
                        <input asp-for="Input.Passive" type="checkbox" />
                        <span>@L["Root.Passive"]</span>
                    </label>
                </mf-field>
            </div>

            <mf-actions>
                <button type="submit" class="mf-btn" asp-page-handler="Test" formnovalidate>
                    <mf-icon name="refresh" />@L["Root.Test"]
                </button>
            </mf-actions>
        </div>

        <h2>@L["Root.Access"]</h2>
        <p class="mf-muted mf-small">@L["Root.AccessHint"]</p>

        <div class="mf-table-wrap">
            <table class="mf-table">
                <thead>
                    <tr>
                        <th scope="col">@L["Role.Name"]</th>
                        <th scope="col">@L["Access.CanRead"]</th>
                        <th scope="col">@L["Access.CanDownload"]</th>
                        <th scope="col">@L["Access.CanUpload"]</th>
                        <th scope="col">@L["Access.CanWrite"]</th>
                        <th scope="col">@L["Access.CanDelete"]</th>
                        <th scope="col">@L["Access.CanShare"]</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Input.Access.Count; i++)
                    {
                        <tr>
                            <td>
                                <input type="hidden" asp-for="Input.Access[i].RoleId" />
                                @Model.Input.Access[i].RoleName
                            </td>
                            <td><input asp-for="Input.Access[i].CanRead" type="checkbox" /></td>
                            <td><input asp-for="Input.Access[i].CanDownload" type="checkbox" /></td>
                            <td><input asp-for="Input.Access[i].CanUpload" type="checkbox" /></td>
                            <td><input asp-for="Input.Access[i].CanWrite" type="checkbox" /></td>
                            <td><input asp-for="Input.Access[i].CanDelete" type="checkbox" /></td>
                            <td><input asp-for="Input.Access[i].CanShare" type="checkbox" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <mf-actions>
            <button type="submit" class="mf-btn mf-btn-primary">
                <mf-icon name="save" />@L["Common.Save"]
            </button>
            <a class="mf-btn" href="@(string.IsNullOrEmpty(Model.ReturnUrl) ? Url.Page("./Index") : Model.ReturnUrl)">
                <mf-icon name="arrow-left" />@L["Common.Back"]
            </a>

            @if (!Model.IsNew)
            {
                <mf-actions-gap />
                <button type="submit" class="mf-btn mf-btn-danger" asp-page-handler="Delete"
                        formnovalidate data-confirm="@L["Common.ConfirmDelete"]">
                    <mf-icon name="trash" />@L["Common.Delete"]
                </button>
            }
        </mf-actions>
    </form>
</div>
